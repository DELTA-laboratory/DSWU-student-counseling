rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // semesterSettings: Public read for calendar, write allowed for admin portal
    match /semesterSettings/{semesterId} {
      allow read, write: if true;
    }

    // classSchedules: Public read for availability calculation, write allowed for admin portal
    match /classSchedules/{scheduleId} {
      allow read, write: if true;
    }

    // personalSchedules: Managed via professor admin portal
    match /personalSchedules/{scheduleId} {
      allow read, write: if true;
    }

    // slotLocks: 30-minute locked blocks
    match /slotLocks/{lockId} {
      allow read, write: if true;
    }

    // students: Registered student list per semester
    match /students/{studentDocId} {
      allow read, write: if true;
    }

    // appointments: Student counseling appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // adminUsers: collection storing allowed admin UIDs/emails
    match /adminUsers/{uid} {
      allow read, write: if true;
    }

    // test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
